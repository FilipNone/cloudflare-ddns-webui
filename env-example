# ---- Required ----
# Cloudflare API token. Create it with the "Edit zone DNS" template at
# https://dash.cloudflare.com/profile/api-tokens
# Permissions: Zone → Zone → Read, Zone → DNS → Edit
CLOUDFLARE_API_TOKEN=your-api-token

# Admin password for the web GUI (min 8 characters).
# PBKDF2-hashed in memory at boot; the plaintext is never stored.
ADMIN_PASSWORD=change-me-min-8-chars

# Docker secrets compatible variants (take a file path instead of a value):
# CLOUDFLARE_API_TOKEN_FILE=/run/secrets/cloudflare_api_token
# ADMIN_PASSWORD_FILE=/run/secrets/admin_password

# ---- Server ----
# Address and port the web UI binds to.
#LISTEN=0.0.0.0:8080
# Session lifetime (e.g. 86400, 24h, 7d → use seconds/minutes/hours suffix).
#SESSION_TTL=24h
# Add the Secure attribute to session cookies. Enable when serving over HTTPS
# (e.g. behind Dokploy's Traefik with a certificate).
#SECURE_COOKIES=false
# Timeout for Cloudflare API requests.
#UPDATE_TIMEOUT=30s

# ---- DDNS dashboard (optional, same semantics as cloudflare-ddns) ----
# Domains shown on the dashboard with sync status + on-demand updates.
#DOMAINS=example.com,www.example.com
# Public IP detection providers: ipify, cloudflare.trace, url:<url>, literal:<ip>, none
#IP4_PROVIDER=ipify
#IP6_PROVIDER=cloudflare.trace
# Defaults applied by on-demand updates.
#TTL=1
#PROXIED=false
#RECORD_COMMENT=Managed by cloudflare-ddns
#DETECTION_TIMEOUT=5s

# ---- Output ----
#EMOJI=true
#QUIET=false

# ---- Development only ----
# Point the backend at a mock Cloudflare API (see scripts/mock-cloudflare-api.py).
#CLOUDFLARE_API_BASE=http://127.0.0.1:8787/client/v4
