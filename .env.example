# Cloudflare DDNS Web UI - environment variables
# Copy this file to .env and pass it with `docker run --env-file .env` or
# Compose `env_file:`. Both take each value literally, so don't add quotes,
# and don't `source` the file in a shell, which splits values with spaces.
# Give the GUI its own file: it refuses to start on cloudflare-ddns settings
# it does not implement, such as UPDATE_CRON.
# Booleans: true / yes / 1 or false / no / 0 (any case); anything else stops startup.
# Durations: whole seconds with an optional s, m or h suffix (90, 30s, 5m, 24h).
# A variable set to an empty value counts as unset and gets its default.

# === Required ===

# Cloudflare API token with Zone > DNS > Edit and Zone > Zone > Read on the
# zones you want to manage: https://dash.cloudflare.com/profile/api-tokens
# Do not wrap the value in quotes. The placeholder below is rejected at startup.
CLOUDFLARE_API_TOKEN=YOUR-CLOUDFLARE-API-TOKEN
# Or read it from a file, such as a Docker secret (used only when
# CLOUDFLARE_API_TOKEN is unset; at most 4 KiB):
# CLOUDFLARE_API_TOKEN_FILE=/run/secrets/cloudflare_api_token

# There is no password setting. You create the admin password in the browser
# on first run, over loopback, before allowing remote access.

# === Server ===

# Address and port to listen on (default: 0.0.0.0:8080)
# LISTEN=0.0.0.0:8080

# Where the account and UI settings are saved (default: /data).
# Mount a volume here, or recreating the container resets the account.
# DATA_DIR=/data

# Session lifetime (default: 24h)
# SESSION_TTL=24h

# Mark the session cookie Secure and name it __Host-cfddns_session.
# Turn it on behind HTTPS (default: false)
# SECURE_COOKIES=false

# Exact origin your reverse proxy serves. Must be HTTPS (HTTP only on
# loopback); HTTPS needs SECURE_COOKIES=true. This also enables Passkey
# registration and sign-in. When unset, Passkeys are disabled and only IP
# addresses and localhost are accepted as the host.
# PUBLIC_ORIGIN=https://dns-admin.example.com

# === DDNS page (optional, same meaning as in cloudflare-ddns) ===

# Domains for A and AAAA records (comma-separated)
# DOMAINS=example.com,www.example.com
# IP4_DOMAINS=v4only.example.com
# IP6_DOMAINS=v6only.example.com

# IP detection: ipify, cloudflare.trace, cloudflare.trace:<url>, url:<url>,
# literal:<ip> or none
# IP4_PROVIDER=ipify
# IP6_PROVIDER=cloudflare.trace

# === DNS records written by Update now ===

# TTL in seconds: 1 (Auto) or 30 to 86400 (default: 1)
# TTL=1

# Proxy new records; proxied records use TTL 1 (default: false)
# PROXIED=false

# Comment on records Update now writes. At most 500 bytes; Free zones
# allow 100 characters.
# RECORD_COMMENT=Managed by cloudflare-ddns

# How Update now treats records cloudflare-ddns also manages
# (default: standalone-v1). shared-v1 only touches records whose comment
# matches an anchored exact regex that also matches RECORD_COMMENT, and needs
# GUI_SHARED_UPDATER_PAUSED=true to confirm you paused cloudflare-ddns first.
# GUI_DDNS_CONTRACT=standalone-v1
# MANAGED_RECORDS_COMMENT_REGEX=^Managed by cloudflare-ddns$
# GUI_SHARED_UPDATER_PAUSED=false

# === Timeouts ===

# Cloudflare API request timeout (default: 30s)
# UPDATE_TIMEOUT=30s

# IP detection timeout (default: 5s)
# DETECTION_TIMEOUT=5s

# === Output ===

# Emoji in log output (default: true)
# EMOJI=true

# Less log output (default: false)
# QUIET=false

# === Development only ===

# Send API requests to the local mock (scripts/mock-cloudflare-api.py).
# Accepts loopback addresses only.
# CLOUDFLARE_API_BASE=http://127.0.0.1:8787/client/v4
